#!/usr/bin/env bash
# Linear ready-queue poller for taskloop.
# Emits one stdout block per change in the Todo queue so the harness's
# Monitor tool wakes Claude on every delta.
#
# Placeholders substituted at init time:
#   {{ENV_FILE}}   -> $MEM/.env
#   {{STATE_FILE}} -> $MEM/.monitor-state
#
# Override polling cadence with: INTERVAL=30 ./monitor.sh

set -o pipefail

ENV_FILE="{{ENV_FILE}}"
STATE_FILE="{{STATE_FILE}}"
INTERVAL="${INTERVAL:-60}"

if [ ! -f "$ENV_FILE" ]; then
  echo "[monitor] error: env file not found at $ENV_FILE" >&2
  exit 1
fi

while true; do
  # Re-source on every tick so token rotations take effect.
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a

  if [ -z "${LINEAR_API_KEY:-}" ] || [ -z "${LINEAR_PROJECT_ID:-}" ]; then
    echo "[monitor] error: LINEAR_API_KEY or LINEAR_PROJECT_ID missing in $ENV_FILE"
    sleep "$INTERVAL"
    continue
  fi

  QUERY="query{project(id:\"$LINEAR_PROJECT_ID\"){issues(first:25,filter:{state:{name:{eq:\"Todo\"}}},orderBy:updatedAt){nodes{identifier title state{name} priority updatedAt}}}}"
  PAYLOAD=$(printf '{"query":"%s"}' "$QUERY")

  RESPONSE=$(curl -sS -X POST https://api.linear.app/graphql \
    -H "Authorization: $LINEAR_API_KEY" \
    -H "Content-Type: application/json" \
    --max-time 30 \
    -d "$PAYLOAD" 2>/dev/null || true)

  if [ -z "$RESPONSE" ]; then
    sleep "$INTERVAL"
    continue
  fi

  # Build a stable signature: sorted "id|status|updatedAt" lines.
  SIG=$(printf '%s' "$RESPONSE" \
    | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    nodes = data["data"]["project"]["issues"]["nodes"]
except Exception:
    sys.exit(0)
for n in nodes:
    print(f"{n[\"identifier\"]}|{n[\"state\"][\"name\"]}|{n[\"updatedAt\"]}|{n[\"title\"]}")
' 2>/dev/null | sort || true)

  PREV=""
  if [ -f "$STATE_FILE" ]; then
    PREV=$(cat "$STATE_FILE")
  fi

  if [ "$SIG" != "$PREV" ]; then
    COUNT=$(printf '%s' "$SIG" | grep -c . || true)
    echo "[monitor] queue changed: ${COUNT} actionable issue(s)"
    printf '%s\n' "$SIG" | head -n 5 | while IFS='|' read -r ID STATUS UPDATED TITLE; do
      [ -z "$ID" ] && continue
      printf '[monitor]  %s\t%s\t%s\t%s\n' "$ID" "$STATUS" "$UPDATED" "$TITLE"
    done
    printf '%s' "$SIG" > "$STATE_FILE"
  fi

  sleep "$INTERVAL"
done
