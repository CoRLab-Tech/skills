#!/usr/bin/env node
// taskloop agent-routing gate — PreToolUse hook on subagent spawns (Task/Agent).
// Mechanically enforces the model-effort-routing rule with the project's
// routing PROFILE (chosen at init) over a 4-rung ladder:
//   light → (no floor)   standard → BALANCED   deep → DEEP   frontier/verdict → TOP
// Under-floor spawns are upgraded in place (updatedInput). It NEVER downgrades —
// rank comparison means a spawn already above its floor passes untouched — and
// it ignores spawns without the [LOOP-AGENT] marker, so non-taskloop usage is
// unaffected.
//
// It ALSO writes the spawn ledger: one append-only JSONL line per loop spawn,
// recording what was spawned, where, on which model, at which effort. This is a
// MECHANISM, not a convention — the loop cannot forget to write it. Token counts
// are not known at spawn time; `usage-rollup.mjs` joins them in afterwards by
// tool_use_id. Telemetry never blocks a spawn: every write is best-effort.
//
// Placeholders substituted at init time (from the routing-profile interview):
//   {{TOP_MODEL}}      -> frontier tier + every verdict (fable | opus)
//   {{DEEP_MODEL}}     -> deep-tier floor (opus keeps its place under a fable top)
//   {{BALANCED_MODEL}} -> standard-tier floor (e.g. sonnet)
//   {{MEM}}            -> the project's memory dir (absolute)

import fs from 'node:fs';

const TOP_MODEL = '{{TOP_MODEL}}';
const DEEP_MODEL = '{{DEEP_MODEL}}';
const BALANCED_MODEL = '{{BALANCED_MODEL}}';
const MEM = '{{MEM}}';
const RANK = { haiku: 0, sonnet: 1, opus: 2, fable: 3 };

let raw = '';
process.stdin.on('data', (c) => (raw += c));
process.stdin.on('end', () => {
  let payload;
  try { payload = JSON.parse(raw); } catch { process.exit(0); }
  const ti = payload.tool_input || {};
  const prompt = String(ti.prompt || '');

  const marker = prompt.match(/^\[LOOP-AGENT([^\]]*)\]/);
  if (!marker) process.exit(0); // not a loop spawn — hands off

  const attrs = marker[1];
  const issue = (attrs.match(/issue:(\S+)/) || [])[1] || null;
  const tier = (attrs.match(/tier:(light|standard|deep|frontier)/) || [])[1] || 'standard';
  const strategy = (attrs.match(/strategy:(auto|fast|balanced|heavy)/) || [])[1] || null;
  const verdict = /verdict:yes/.test(attrs);
  const model = ti.model; // undefined = inherit session model

  // Append-only spawn ledger. Never throws into the hook's decision path: a
  // telemetry failure must not stop the loop from spawning an agent.
  const record = (finalModel, upgraded, why) => {
    try {
      const now = new Date();
      const dir = `${MEM}/telemetry`;
      fs.mkdirSync(dir, { recursive: true });
      fs.appendFileSync(`${dir}/spawns-${now.toISOString().slice(0, 7)}.jsonl`,
        JSON.stringify({
          ts: now.toISOString(),
          session_id: payload.session_id ?? null,
          tool_use_id: payload.tool_use_id ?? null,
          issue,
          tier,
          strategy,
          verdict,
          requested_model: model ?? null,
          final_model: finalModel ?? null,
          effort: ti.effort ?? null,
          upgraded,
          why: why ?? null,
          label: ti.description ?? null,
          agent_type: ti.subagent_type ?? null,
        }) + '\n');
    } catch { /* telemetry is best-effort, always */ }
  };

  const upgrade = (newModel, why) => {
    record(newModel, true, why);
    process.stdout.write(JSON.stringify({
      systemMessage: `taskloop routing gate: ${why} — model set to ${newModel} (was ${model || 'unset'})`,
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'allow',
        updatedInput: { ...ti, model: newModel },
      },
    }));
    process.exit(0);
  };

  if (verdict || tier === 'frontier') {
    // Pin explicitly — even "unset" — so a mid-session /model downgrade can't
    // leak into a verdict. Already at/above the profile's top? Untouched.
    if (!model || (RANK[model] ?? -1) < (RANK[TOP_MODEL] ?? 3)) {
      upgrade(TOP_MODEL, verdict ? 'verdict agents judge on the top model' : 'frontier tier is pinned to the top model');
    }
  } else if (tier === 'deep') {
    // Floor only — an unset model inherits the session (assumed ≥ deep floor);
    // an explicit under-floor choice gets raised. Never lowered.
    if (model && (RANK[model] ?? -1) < (RANK[DEEP_MODEL] ?? 2)) {
      upgrade(DEEP_MODEL, 'deep tier has a floor');
    }
  } else if (tier === 'standard') {
    if (model && (RANK[model] ?? -1) < (RANK[BALANCED_MODEL] ?? 1)) {
      upgrade(BALANCED_MODEL, 'standard tier must not run on the fastest model');
    }
  }

  // Compliant spawn (light tier, or already at/above its floor): record and pass through.
  record(model ?? null, false, null);
  process.exit(0);
});
