#!/usr/bin/env node
// taskloop agent-routing gate — PreToolUse hook on subagent spawns (Task/Agent).
// Mechanically enforces the model-effort-routing rule with the project's
// routing PROFILE (chosen at init): under-modeled spawns are upgraded in
// place (updatedInput). It NEVER downgrades — a spawn already at or above the
// profile's top passes untouched — and it ignores every spawn that does not
// carry the [LOOP-AGENT] marker, so non-taskloop agent usage is unaffected.
//
// Placeholders substituted at init time (from the routing-profile interview):
//   {{TOP_MODEL}}      -> the profile's top model / upgrade target (fable | opus)
//   {{TOP_SCOPE}}      -> what gets pinned to the top: verdict | verdict+deep | all
//   {{BALANCED_MODEL}} -> floor for the standard tier (e.g. sonnet)

const TOP_MODEL = '{{TOP_MODEL}}';
const TOP_SCOPE = '{{TOP_SCOPE}}';
const BALANCED_MODEL = '{{BALANCED_MODEL}}';
// Models never rewritten downward, regardless of profile: at-or-above any top.
const AT_OR_ABOVE_TOP = new Set(['fable', 'opus']);

let raw = '';
process.stdin.on('data', (c) => (raw += c));
process.stdin.on('end', () => {
  let payload;
  try { payload = JSON.parse(raw); } catch { process.exit(0); }
  const ti = payload.tool_input || {};
  const prompt = String(ti.prompt || '');

  const marker = prompt.match(/^\[LOOP-AGENT([^\]]*)\]/);
  if (!marker) process.exit(0); // not a loop spawn — hands off

  const attrs = marker[1];
  const tier = (attrs.match(/tier:(light|standard|deep)/) || [])[1] || 'standard';
  const verdict = /verdict:yes/.test(attrs);
  const model = ti.model; // undefined = inherit session model

  const upgrade = (newModel, why) => {
    process.stdout.write(JSON.stringify({
      systemMessage: `taskloop routing gate: ${why} — model set to ${newModel} (was ${model || 'unset'})`,
      hookSpecificOutput: {
        hookEventName: 'PreToolUse',
        permissionDecision: 'allow',
        updatedInput: { ...ti, model: newModel },
      },
    }));
    process.exit(0);
  };

  const needsTop =
    verdict ||
    TOP_SCOPE === 'all' ||
    (TOP_SCOPE === 'verdict+deep' && tier === 'deep');

  if (needsTop) {
    // Pin explicitly — even "unset", so a mid-session /model downgrade can't
    // leak into a verdict. Already at/above the top (e.g. fable under an opus
    // profile)? Untouched: the gate upgrades, never downgrades.
    if (!model || !AT_OR_ABOVE_TOP.has(model)) {
      upgrade(TOP_MODEL, verdict ? 'verdict agents judge on the top model' : 'this tier is pinned to the top model by the routing profile');
    }
  } else if (tier === 'standard' && model === 'haiku') {
    upgrade(BALANCED_MODEL, 'standard tier must not run on the fastest model');
  }
  // light tier / compliant spawns: silent pass-through
  process.exit(0);
});
